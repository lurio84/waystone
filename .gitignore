# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
# /android SÍ se versiona: sin EAS, con gradle tuneado a mano (arm64-only +
# jvmargs) que `expo prebuild` resetea y es el único motivo de que el build
# termine en Windows. `android/.gitignore` excluye build/, .gradle/, .cxx/ y
# local.properties (ruta absoluta de máquina).

# fixtures regenerables con scripts/fixtures/make-fixture.ts
/scripts/fixtures/*.json
